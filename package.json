{
  "name": "carterax-fusion",
  "version": "0.3.0-prototype",
  "description": "CarteraX - prototipo fusionado con ETL, SQLite normalizado, Android y servidor HTTP",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copiar-assets.js",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "servidor": "npm run build && node scripts/servidor.js",
    "simulador-movil": "node scripts/simulador-movil.js",
    "prueba": "npm run build && node pruebas/cargador.prueba.js",
    "ejemplos": "node scripts/generar-ejemplos.js",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.0.20",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "cl.carterax.desktop",
    "productName": "CarteraX",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CarteraX"
    }
  }
}
