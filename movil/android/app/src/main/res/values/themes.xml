<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Claro u oscuro según el sistema (los colores cambian en values-night). -->
    <style name="Theme.PhoenixMobile" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/phoenix_naranja</item>
        <item name="colorPrimaryVariant">@color/phoenix_naranja_hondo</item>
        <item name="colorOnPrimary">@color/tinta_fija</item>
        <item name="colorSecondary">@color/phoenix_naranja</item>
        <item name="colorOnSecondary">@color/tinta_fija</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/tinta</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/grafito</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/tinta</item>
        <item name="android:textColorSecondary">@color/pizarra</item>
        <item name="materialCardViewStyle">@style/Phoenix.Tarjeta</item>
        <item name="materialButtonStyle">@style/Phoenix.Boton</item>
    </style>

    <style name="Phoenix.Tarjeta" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/linea</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Phoenix.Boton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">6dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Botones de texto y contorno: sin mayúsculas forzadas, como en el escritorio. -->
    <style name="Phoenix.BotonTexto" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/phoenix_naranja_hondo</item>
    </style>

    <style name="Phoenix.BotonContorno" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tinta</item>
        <item name="strokeColor">@color/linea</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <style name="Phoenix.TituloTarjeta">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tinta</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Phoenix.FilaPermiso">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- Segmento de la franja de estados de la cabecera -->
    <style name="Phoenix.Franja">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
    </style>
</resources>
